{
  "name": "site-indicator",
  "version": "1.2.0",
  "description": "Tell production from staging at a glance: a ribbon on the page and a badge on the tab icon for the websites you choose.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hpedrorodrigues/site-indicator.git"
  },
  "scripts": {
    "build": "node buildSrc/build.js",
    "start": "node buildSrc/devServer.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:locales": "node buildSrc/checkLocales.js",
    "fmt": "prettier --write '**/*.{js,jsx,mjs,ts,tsx,json,yaml,yml,css,scss,md}' '!build/**' '!zip/**'",
    "fmt:check": "prettier --check '**/*.{js,jsx,mjs,ts,tsx,json,yaml,yml,css,scss,md}' '!build/**' '!zip/**'"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "antd": "^6.7.1",
    "dns-over-http-resolver": "^3.0.16",
    "ipaddr.js": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "babel-loader": "^10.1.1",
    "confusing-browser-globals": "^1.0.11",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.10.1",
    "react-refresh": "^0.19.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "ssestream": "^1.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "webpack": "^5.112.2",
    "webpack-dev-server": "^6.1.0",
    "zip-webpack-plugin": "^4.0.3"
  }
}
